// agents/portfolio_manager.jsonc
{
  "role": "Lead Portfolio Manager",
  "goal": "{goal_portfolio_manager}",  // text in agent_profiles.yaml
  "backstory": "{backstory_portfolio_manager}",  // text in agent_profiles.yaml
  "llm": {"python": "models.portfolio_manager"},  // model chosen in models.jsonc
  "tools": [],

  // --- Guardrails: execution limits ---
  "allow_delegation": false,  // set true only if you switch to hierarchical and make this the manager
  "max_iter": 10,                    // hard cap on reasoning/tool loops
  "max_execution_time": 600,        // seconds; stops runaway tasks
  "max_rpm": 15,                    // throttle to protect API and data-provider quotas
  "max_retry_limit": 2,              // retries on errors before failing
  "respect_context_window": true,    // summarize instead of overflowing the context
  "inject_date": true,               // agent always knows today's date
  "date_format": "%Y-%m-%d",
  "verbose": true
}
